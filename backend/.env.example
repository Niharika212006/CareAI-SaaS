# ==============================================================================
# AI Healthcare SaaS Platform - Backend Configuration
# ==============================================================================

# Application Environment
PROJECT_NAME="AI Healthcare SaaS Platform"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Security & JWT Authentication
# IMPORTANT: Replace with a secure random secret in production (e.g., openssl rand -hex 32)
SECRET_KEY="development_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default PostgreSQL connection: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local dev without PostgreSQL running, SQLite fallback: sqlite:///./healthcare_dev.db
DATABASE_URL="sqlite:///./healthcare_dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/healthcare_saas"

# CORS Configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# AI Integration Configuration (Modular for Gemini, OpenAI, etc.)
AI_PROVIDER="gemini"
GEMINI_API_KEY="your-gemini-api-key-here"
OPENAI_API_KEY="your-openai-api-key-here"
AI_MODEL_NAME="gemini-1.5-flash"
